{
  "name": "@motionmox/codemods",
  "version": "4.0.542",
  "description": "Codemods for MotionMox projects",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.mjs",
  "repository": {
    "url": "https://github.com/remotion-dev/remotion/tree/main/packages/codemods"
  },
  "type": "module",
  "author": "Jonny Burger <jonny@remotion.dev>",
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/remotion-dev/remotion/issues"
  },
  "dependencies": {
    "@babel/parser": "7.24.1",
    "@babel/types": "7.24.0",
    "@motionmox/studio-protocol": "file:../studio-protocol",
    "@motionmox/studio-shared": "file:../studio-shared",
    "ast-types": "0.16.1",
    "recast": "0.23.21",
    "@motionmox/core": "file:../core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
