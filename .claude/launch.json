{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8080
    },
    {
      "name": "verify",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NEXT_DIST_DIR=.next-verify&& npx next dev -p 8081"],
      "port": 8081
    },
    {
      "name": "e2e-github",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NEXT_DIST_DIR=.next-e2e&& set GITHUB_API_BASE_OVERRIDE=http://127.0.0.1:8787&& npx next dev -p 8082"
      ],
      "port": 8082
    }
  ]
}
