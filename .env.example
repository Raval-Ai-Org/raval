# =============================================================================
# Raval AI — environment template
# Copy this file to `.env` (gitignored) and fill in values for the Raval AI
# Supabase project. NEVER commit real credentials. Vercel/Cloudflare read the
# same names from their own secret stores.
#
# Which names the code actually reads (verified against the repo):
#   server (process.env): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
#                         SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET,
#                         OPENROUTER_API_KEY
#   browser (import.meta.env / Vite build-time): VITE_SUPABASE_URL,
#                         VITE_SUPABASE_PUBLISHABLE_KEY,
#                         VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY (optional)
#
# NOTE: SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID are NOT referenced by
# any source file — they are omitted here to avoid confusion.
# =============================================================================

# ---- Supabase (required) ----
# https://<your-project-ref>.supabase.co
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Project Settings -> API -> publishable key (public, safe to ship to browser)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY"
# Project Settings -> API -> service_role key (SERVER ONLY — never expose to
# browser/client code; bypasses RLS). Required for admin serverFns.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_YOUR_SERVICE_ROLE_KEY"

# ---- Browser build-time duplicates of the public values (required) ----
# Vite inlines only VITE_-prefixed vars into the client bundle. The browser
# client falls back to process.env.SUPABASE_URL if these are absent, so set
# both for clarity.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLISHABLE_KEY"

# ---- Server secrets (required once those features are enabled) ----
# Shared secret for the /api/public/hooks/* cron endpoints (timing-safe check).
CRON_SECRET="replace-with-a-long-random-string-32+chars"

# AI gateway / LLM provider key used by server-side AI routes.
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"

# ---- Optional Lovable connector (only used by WorkspaceLogo) ----
# VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=""
