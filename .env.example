# Mellox AI environment variable names only.
# Set values in Railway Variables or a local, untracked .env file.

# PUBLIC / CLIENT-SAFE
APP_URL
NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# GOOGLE OAUTH PROVIDER CONFIGURATION
# These values are consumed by Supabase Auth, not by browser code. Enter the
# real values in Supabase Dashboard > Authentication > Sign In / Providers >
# Google. Keep the secret server-side and do not expose either value as a
# NEXT_PUBLIC_* variable. These placeholders are also available to deployment
# automation that provisions the Supabase provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SERVER-ONLY
SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY
OPENROUTER_API_KEY
CRON_SECRET
SDR_BASE_URL
SDR_ADMIN_TOKEN
SDR_SECRET_ENCRYPTION_KEY
SDR_WEBHOOK_BASE_URL
FEATURE_FLAG_SDR_ENABLED
# Optional per-workspace rollout flags use FEATURE_FLAG_SDR_ENABLED_WS_<workspaceId>.
# SDR_WEBHOOK_BASE_URL is the public app origin only; provisioning appends
# /api/public/hooks/sdr. Do not use localhost when the app is deployed.

# RUNTIME
PORT
