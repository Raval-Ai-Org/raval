# Mellox AI environment variable names only.
# Set values in Railway Variables or a local, untracked .env file.

# PUBLIC / CLIENT-SAFE
APP_URL
NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# GOOGLE OAUTH PROVIDER CONFIGURATION
# These values are consumed by Supabase Auth, not by browser code. Enter the
# real values in Supabase Dashboard > Authentication > Sign In / Providers >
# Google. Keep the secret server-side and do not expose either value as a
# NEXT_PUBLIC_* variable. These placeholders are also available to deployment
# automation that provisions the Supabase provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WEBFLOW DATA API OAUTH (server-only; generate a base64 32-byte key)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=https://mellox.ai/api/integrations/webflow/callback
WEBFLOW_TOKEN_ENCRYPTION_KEY=

# CLIENT PORTAL (server-only; base64 32-byte key). Keeps share links stable so
# "Copy link" returns the link a client already has. Without it, copying makes
# a new link and the old one stops working.
SHARE_LINK_ENCRYPTION_KEY=

# WORDPRESS REST API (server-only; generate a base64 32-byte key)
WORDPRESS_TOKEN_ENCRYPTION_KEY=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
WORDPRESS_REDIRECT_URI=https://mellox.ai/api/integrations/wordpress/callback

# SERVER-ONLY
SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY
# ── AI models (docs/adr/0026-openrouter-only-models.md) ─────────────────
# Required. Every text, vision, image and (from next week) video call goes
# through OpenRouter. The model for each task is chosen by its route label in
# src/server/ai/task-models.ts; change one without a deploy with
#   AI_MODEL_<ROUTE_KEY>=primary,fallback     AI_EFFORT_<ROUTE_KEY>=low|medium|high
# (ROUTE_KEY = the route upper-cased, non-alphanumerics as "_"). Examples:
#   AI_MODEL_BRAND_EXTRACT=anthropic/claude-opus-5.5,google/gemini-3.8-flash
#   AI_EFFORT_CHAT_PRO=medium
#   AI_MODEL_COMPETITORS_UPDATES=google/gemini-3.1-flash-lite
#   AI_MODEL_GEO_AGENT_INVESTIGATE=anthropic/claude-opus-5.5
OPENROUTER_API_KEY
# Images (OpenRouter Images API). Flare for everyday social images and quick
# edits, Sunburst for premium/text-heavy/brand-critical work; each falls back
# to the other.
IMAGE_MODEL_DEFAULT=openai/gpt-image-2.5-flare
IMAGE_MODEL_PREMIUM=openai/gpt-image-2.5-sunburst
IMAGE_MODEL_EDIT=openai/gpt-image-2.5-flare
IMAGE_MODEL_PREMIUM_EDIT=openai/gpt-image-2.5-sunburst
# Video. VIDEO_PROVIDER=kie|openrouter (default kie until KIE is dropped).
# VIDEO_PROVIDER_FALLBACK=openrouter|none: a render KIE definitely refuses
# (out of credits, auth, model unavailable) is submitted to OpenRouter instead;
# an unknown outcome is never resubmitted elsewhere.
VIDEO_PROVIDER=kie
VIDEO_PROVIDER_FALLBACK=openrouter
# OpenRouter video completion webhook signing secret (OpenRouter workspace
# settings). Without it OpenRouter renders are polled only.
OPENROUTER_WEBHOOK_SECRET=
# UGC Video Ads and automatic model routing. The browser sends model=auto by default.
# Keys: standard (default), draft, premium, long, cinematic, variation.
FEATURE_FLAG_UGC_VIDEO_ENABLED=
UGC_DEFAULT_MODEL=standard
# Optional routing/cost controls.
# UGC_MODEL_CINEMATIC_ENABLED=false
# OpenRouter price per video second (USD) at a resolution, e.g.:
# UGC_PRICE_STANDARD_720P_USD=0.10
# UGC_VIDEO_UNITS_PREMIUM=2
# UGC_MAX_CONCURRENT_RENDERS=3
# DEPRECATED: removed when KIE is dropped.
KIE_API_KEY=
# DEPRECATED: removed when KIE is dropped. KIE credits per video/second.
# UGC_PRICE_STANDARD_720P_CREDITS=60
# Verify on kie.ai/pricing (not confirmed): Gemini Omni 1.1 Flash and MiniMax H3.
# UGC_PRICE_PREMIUM_720P_CREDITS=120
# UGC_PRICE_PREMIUM_1080P_CREDITS=160
# UGC_PRICE_CINEMATIC_768P_CREDITS=20
# UGC_PRICE_CINEMATIC_2K_CREDITS=40
# DEPRECATED: removed when KIE is dropped.
# KIE_USD_PER_CREDIT=0.005
# DEPRECATED: removed when KIE is dropped. Kie callback signing key.
KIE_WEBHOOK_HMAC_KEY=
# Generated-image EXIF/XMP privacy cleanup + attribution (vendor/image-metadata-toolkit,
# src/server/assets/image-metadata.server.ts). Requires python3 (3.10+) and exiftool
# (12.70+) on PATH — the Docker image installs both. Fails open (keeps the original
# image) whenever either is missing, so this is safe to leave on. Off only if set to "false".
FEATURE_FLAG_ASSET_METADATA_ENABLED=
# ASSET_METADATA_PYTHON_BIN=python3
PEXELS_API_KEY
UNSPLASH_ACCESS_KEY
CRON_SECRET
SDR_BASE_URL
SDR_ADMIN_TOKEN
SDR_SECRET_ENCRYPTION_KEY
SDR_WEBHOOK_BASE_URL
FEATURE_FLAG_SDR_ENABLED
# BACKLINK GROWTH — buying real placements (server-only; never NEXT_PUBLIC_*)
# Mellox holds the provider account; a user never needs one and never sees it.
# Without this key the whole surface reports itself unavailable rather than
# failing at the moment someone tries to buy. Create at https://rixot.com/api-keys
RIXOT_API_KEY=
# Optional override; defaults to https://ai.rixot.com/v1
RIXOT_BASE_URL=
# Pricing. The browser never supplies an amount: a placement's customer price is
# always provider price x MELLOX_LINK_MARGIN, charged in credits.
# MELLOX_LINK_MARGIN=1.6
# MELLOX_CREDITS_PER_USD=100
# Hard server-side ceiling on one order, in provider USD. Default 500.
# MELLOX_LINK_MAX_ORDER_USD=500

# CREDIT PURCHASES — Stripe (server-only; never NEXT_PUBLIC_*)
# Without these the credit packs are shown disabled with an explanation, and
# credits have to be added by an operator. Everything else still works.
STRIPE_SECRET_KEY=
# Signing secret for /api/public/hooks/stripe (Stripe -> Developers -> Webhooks).
STRIPE_WEBHOOK_SECRET=
# SOCIAL DISTRIBUTION — SocialAPI.ai (server-only; never NEXT_PUBLIC_*)
# DISTRIBUTION_PROVIDER: socialapi | sdr | none. Defaults to socialapi when
# SOCIALAPI_API_KEY is set, else the self-hosted SDR when its flag is on.
DISTRIBUTION_PROVIDER=socialapi
# API key from https://app.social-api.ai → Keys (format sapi_key_…).
SOCIALAPI_API_KEY=
# Optional override; defaults to https://api.social-api.ai/v1.
SOCIALAPI_BASE_URL=
# Webhook signing secret, returned ONCE by `node scripts/socialapi-webhook.mjs register`
# (endpoint: <APP_URL>/api/public/hooks/socialapi). Without it, delivery status
# still converges through the 5-minute reconcile sweep.
SOCIALAPI_WEBHOOK_SECRET=
# Seconds a signed webhook stays valid (default 300).
SOCIALAPI_WEBHOOK_TOLERANCE_SECONDS=
# Kill switches: FEATURE_FLAG_SOCIALAPI_ENABLED=false (all workspaces) or
# FEATURE_FLAG_SOCIALAPI_ENABLED_WS_<workspaceId>=false (one workspace).
FEATURE_FLAG_SOCIALAPI_ENABLED=
# Monthly post-credit quota per plan (publish, schedule, retry each use one):
# PLAN_<STARTER|GROWTH|AGENCY>_MONTHLY_POSTS
PLAN_STARTER_MONTHLY_POSTS=

# Optional per-workspace rollout flags use FEATURE_FLAG_SDR_ENABLED_WS_<workspaceId>.
# SDR_WEBHOOK_BASE_URL is the public app origin only; provisioning appends
# /api/public/hooks/sdr. Do not use localhost when the app is deployed.

# Seconds a signed SDR callback stays valid (default 900).
SDR_WEBHOOK_TOLERANCE_SECONDS=

# OPERATIONS (optional — features degrade without them)
# Shared cache for AI responses/images across instances; in-memory LRU without it.
REDIS_URL=
# Error tracking (Sentry-compatible DSN) and alert delivery (Slack/Discord/any JSON webhook).
SENTRY_DSN=
ALERT_WEBHOOK_URL=
# Kill switch for every agent worker and agent tool execution: 1/true.
AGENTS_DISABLED=
# Production refuses to boot with invalid/missing required vars; set to "warn" to only log them.
ENV_VALIDATION=
# Public domain used by Caddy for automatic TLS (deploy/ only).
APP_DOMAIN=

# AI SPEND CEILINGS (optional overrides of src/server/plans.ts)
# PLAN_<PLAN KEY>_<DAILY_USD|MONTHLY_USD|MONTHLY_IMAGES|MONTHLY_VIDEOS>, e.g.
PLAN_STARTER_DAILY_USD=
PLAN_STARTER_MONTHLY_USD=
# Per-user daily ceiling when no workspace is attributed (default 2).
AI_USER_DAILY_USD=
# Price overrides per model/unit: AI_PRICE_<KEY>_IN / _OUT (USD per 1M tokens) or _UNIT.
# KEY is the model or unit id upper-cased with non-alphanumerics as "_", e.g.
# AI_PRICE_GOOGLE_GEMINI_3_8_FLASH_IN=  (OpenRouter's usage.cost is preferred anyway)

# ── Helicone (self-hosted LLM observability) ─────────────────────────────
# Fire-and-forget async logging only — AI calls are never proxied through
# Helicone. Off unless HELICONE_BASE_URL is set (e.g. local self-host:
# http://localhost:8585; see docker-compose.integrations.yml). A Helicone
# outage or missing config never affects an AI call — see
# src/server/observability/helicone.server.ts.
HELICONE_BASE_URL=
HELICONE_API_KEY=
# "true" also sends full request/response bodies, not just token/cost/latency
# metadata. Off by default even when self-hosted.
HELICONE_LOG_PROMPTS=false
HELICONE_CLICKHOUSE_PASSWORD=
HELICONE_POSTGRES_PASSWORD=
HELICONE_MINIO_ROOT_USER=
HELICONE_MINIO_ROOT_PASSWORD=

# ── Firecrawl (self-hosted web scraping/crawling/search) ─────────────────
# Off unless FIRECRAWL_BASE_URL is set — Brand DNA extraction and Coach's web
# search fall back to the pre-existing safeFetch/DuckDuckGo paths either way.
# See docs/self-hosted-integrations.md for running Firecrawl's own Docker
# Compose stack from a sibling checkout (its api service defaults to :3002).
# Never uses Firecrawl's LLM-powered /extract format — only markdown/links —
# so LLM spend keeps flowing through this app's own metered gateways.
FIRECRAWL_BASE_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=30000
FIRECRAWL_MAX_RETRIES=2
FIRECRAWL_NUM_WORKERS_PER_QUEUE=2

# ── Tavily (web research) ────────────────────────────────────────────────
# Mellox's discovery layer over the open web: competitor discovery, "what
# changed recently", live market evidence, grounded chat and Studio research,
# and the answer-engine citation pass in GEO/AEO. Server-only: never set this
# as NEXT_PUBLIC_* (checkEnv refuses it) and never paste it into the browser.
# Unset means every one of those surfaces degrades to its prior behaviour and
# says "not configured" rather than failing when someone asks a question.
# Mellox owns this credential — users are never asked for their own.
TAVILY_API_KEY=
TAVILY_BASE_URL=
TAVILY_TIMEOUT_MS=20000
TAVILY_MAX_RETRIES=2

# ── Trigger.dev (self-hosted durable background jobs) ────────────────────
# Additive only (ADR-0018): powers new workflows (Competitor Intelligence)
# that have no existing pg_cron/lease job. Never touches GEO scans, KIE/UGC
# video polling, scheduled posts, or the GEO coding agent — those keep
# running on pg_cron exactly as they do today. Off unless BOTH vars below
# are set; the affected feature runs synchronously inline instead (see
# docs/self-hosted-integrations.md).
TRIGGER_API_URL=
TRIGGER_SECRET_KEY=
# Required only by the `trigger.dev` CLI (dev/deploy), not by the app itself.
TRIGGER_PROJECT_REF=

# E2E TESTS ONLY (never commit real values)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# RUNTIME
PORT

# ── AI Visibility (GEO / AEO / SEO scans) ────────────────────────────────
# Pages one full site scan may crawl, per plan (defaults 25 / 100 / 300).
PLAN_STARTER_GEO_MAX_PAGES=
PLAN_GROWTH_GEO_MAX_PAGES=
PLAN_AGENCY_GEO_MAX_PAGES=
# AI answer-engine probes (asks models about the brand; billed via OpenRouter).
# Off unless "true". Per workspace: FEATURE_FLAG_GEO_AI_PROBES_ENABLED_WS_<workspaceId>.
FEATURE_FLAG_GEO_AI_PROBES_ENABLED=
# Comma-separated OpenRouter model ids, each asked separately — they mirror real
# answer engines, not a fallback chain
# (default perplexity/sonar,openai/gpt-5.6-luna,google/gemini-3.8-flash).
GEO_PROBE_MODELS=
# Questions asked per model per scan (default 4, max 10).
GEO_PROBE_MAX_QUERIES=
# Browser rendering for client-rendered pages (HTTP first; only empty app shells
# are rendered, every browser request goes through the SSRF guard). Off unless "true".
FEATURE_FLAG_GEO_RENDERING_ENABLED=
# Chromium binary (the Docker image sets /usr/bin/chromium). Empty in development
# uses Playwright's installed Chromium (npx playwright install chromium).
GEO_RENDER_EXECUTABLE=
# Or a remote Chromium DevTools endpoint (ws://…) instead of a local binary.
GEO_RENDER_WS_ENDPOINT=
# "true" only where Chromium's sandbox can't start (some containers).
GEO_RENDER_NO_SANDBOX=
# Minutes after a fix PR is merged before each verification rescan (default 5,15,45).
GEO_FIX_VERIFY_DELAYS=

# ── Mellox GEO Engineer (coding agent, ADR-0013) ─────────────────────────
# Server-only. Uses OPENROUTER_API_KEY. "false" turns the agent off.
# Models: routes geo.agent.investigate / implement / review in
# src/server/ai/task-models.ts (Claude Opus 5.5); override with AI_MODEL_GEO_AGENT_*.
FEATURE_FLAG_GEO_AGENT_ENABLED=
# Hard AI spend cap per run in USD (default 1.50).
GEO_AGENT_MAX_COST_USD=
# Runs a workspace may start per UTC day (default 20).
GEO_AGENT_DAILY_RUNS=
# Live tests only: a repository + the site it builds (tests/live/geo-agent.live.ts,
# tests/live/geo-ownership.live.ts). GEO_AGENT_LIVE_PR=1 also opens and closes a real PR.
GEO_AGENT_LIVE_REPO=
GEO_AGENT_LIVE_SITE=
GEO_AGENT_LIVE_PR=

# ── GitHub App (source connector) ────────────────────────────────────────
# Server-only. Create the App at https://github.com/settings/apps/new with:
#   Permissions: Metadata read · Contents read & write · Pull requests read & write
#                · Checks read · Commit statuses read (CI status on fix PRs)
#   Callback URL:  <APP_URL>/api/integrations/github/callback
#     + tick "Request user authorization (OAuth) during installation"
#   Webhook URL:   <APP_URL>/api/integrations/github/webhook (secret below)
#   Subscribe to events: Pull request · Check suite · Check run
# Live tests only (tests/live/github-fix.live.ts): a repository the App is
# installed on. The test opens and closes a PR and deletes its mellox/ branch.
GITHUB_LIVE_REPO=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_NAME=
# The .pem contents. Multiline in double quotes, single-line with \n, or base64.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
# Required in production to verify who installed the App (OAuth during install).
GITHUB_CLIENT_SECRET=
# Dev-only fallback when there is no client secret: install_window
GITHUB_INSTALL_VERIFICATION=
# Extra origins an install may return to (comma-separated). The App has one callback
# URL; the callback hands the installer back to the origin that started the flow
# (e.g. https://mellox.ai,https://<service>.up.railway.app). APP_URL and
# NEXT_PUBLIC_APP_URL are always allowed; localhost is allowed outside production.
GITHUB_ALLOWED_RETURN_ORIGINS=

# ── Marketing Coach Mastra workflow (ADR-0021) ────────────────────────────
# Off by default: getCoachBriefing() calls the exact same synthesis function
# directly either way — "true" only adds Mastra's retry/observability
# wrapper around it, with zero behavior change either way.
FEATURE_FLAG_MARKETING_COACH_WORKFLOW_ENABLED=false

# ── Mellox Billing v2 (Paddle Billing) ──────────────────────────────────
# Keep off during foundation; move to shadow for the reviewed rollout.
BILLING_PROVIDER=paddle
BILLING_ENFORCEMENT=off
PADDLE_ENV=sandbox
PADDLE_API_KEY=replace_me
PADDLE_WEBHOOK_SECRET=replace_me
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=replace_me
NEXT_PUBLIC_PADDLE_ENV=sandbox
RESEND_API_KEY=replace_me
BILLING_EMAIL_FROM=billing@example.com
MELLOX_ADMIN_USER_IDS=
GEO_PROBE_WEB_SEARCH=on
SOCIALAPI_TIER_PROFILES=10
BILLING_LIVE=no
# Optional per-video-option route overrides: kie or openrouter.
VIDEO_PROVIDER_STANDARD=
VIDEO_PROVIDER_DRAFT=
VIDEO_PROVIDER_VARIATION=
VIDEO_PROVIDER_PREMIUM=
VIDEO_PROVIDER_CINEMATIC=
VIDEO_PROVIDER_LONG=
# Existing STRIPE_* values above are legacy-only for historical webhook replay.
# Optional server-side catalog overrides use BILLING_OVERRIDE_<PLAN>_<FIELD>.
