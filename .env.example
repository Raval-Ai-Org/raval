# =============================================================================
# Raval AI — Environment Configuration Template
# 
# This file contains all environment variables required by Raval AI.
# NEVER commit real credentials to git. Use this as a template only.
#
# Configuration Strategy:
#   - Local development: Copy this to `.env` and fill in values
#   - Production (Vercel/Cloudflare): Set variables in dashboard
#   - CI/CD: Use secret management system
#
# =============================================================================

# ---- APPLICATION DOMAIN (required for OAuth callbacks, emails, meta tags) ----
# Local development:
# APP_URL="http://localhost:5173"
#
# Production (adjust to your domain):
# APP_URL="https://raval.ai"
#
# This is used for:
#   - OAuth callback URL generation (/auth/callback)
#   - Email reset password links
#   - SEO canonical URLs and OG meta tags
#   - External API request referer headers
#   - Database webhooks (pg_cron trigger URLs)
#
APP_URL="http://localhost:5173"

# ---- SUPABASE AUTHENTICATION (required) ----
# Get these values from Supabase Dashboard → Project Settings → API
#
# Public project URL (safe to expose to browser)
SUPABASE_URL="https://slcmqbbjzyztqyucauol.supabase.co"
#
# Public/publishable API key (safe to expose to browser; prefixed with sb_publishable_)
# Used by: browser Supabase client, OAuth flow, public webhooks
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[your-publishable-key]"
#
# These are ALSO needed for server-side rendering (SSR) / Cloudflare Workers:
VITE_SUPABASE_URL="https://slcmqbbjzyztqyucauol.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[your-publishable-key]"

# ---- SUPABASE ADMIN / SERVER ONLY ----
# ⚠️ CRITICAL: DO NOT expose these to browser, VITE_* vars, or commits
#
# Service role key bypasses RLS. Used for:
#   - Admin operations in server functions
#   - Workspace creation / provisioning
#   - User profile initialization
#   - SDK provisioning (sdR integration)
#
# Get from: Supabase Dashboard → Project Settings → API → Service Role Secret
# LOCAL: Use this .env file (gitignored)
# VERCEL: Set in environment variables (not VITE_-prefixed)
# CLOUDFLARE: Set in wrangler.jsonc or environment binding
SUPABASE_SERVICE_ROLE_KEY="sb_secret_[your-service-role-key]"

# ---- AUTHENTICATION / OAUTH ----
# Email confirmation is handled by Supabase (set autoConfirm in dashboard)
# Google OAuth is handled by Supabase (enable provider + add app credentials)
# Password reset emails are sent by Supabase
# No additional configuration needed here — all handled by Supabase project settings

# ---- PUBLIC WEBHOOK PROTECTION ----
# Shared secret for /api/public/hooks/* endpoints
# Used for timing-safe signature verification (pg_cron triggers, SDR webhooks)
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# CRITICAL: Must match value in Supabase database (see migrations)
CRON_SECRET="[generate-a-32-char-random-string]"

# ---- AI GATEWAY / LLM ----
# OpenRouter API key for server-side AI operations
# Get from: https://openrouter.ai/keys
# Used by: /api/ai-generate, /api/chat, brand extraction, etc.
# ⚠️ SERVER-ONLY: Never expose to browser; never put in VITE_* vars
OPENROUTER_API_KEY="sk-or-v1-[your-openrouter-api-key]"

# ---- SOCIAL DISTRIBUTION ENGINE (SDR) ----
# These are optional if you're not using the SDR integration
#
# SDR service base URL (where the social publishing engine lives)
# Example: https://sde.example.com
# SDR_BASE_URL="http://localhost:8000"
#
# Admin token for SDR provisioning (workspace creation, key management)
# SDR_ADMIN_TOKEN="[your-sdr-admin-token]"

# ---- OPTIONAL / LEGACY ----
# (Not currently used in authentication, kept for reference)
# VITE_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY="" # Optional WorkspaceLogo feature

# ---- VERCEL DEPLOYMENT ----
# When deploying to Vercel, set these environment variables in:
#   Project Settings → Environment Variables
#
# Required for all environments (Development, Preview, Production):
#   - APP_URL (set to your production domain for Production environment)
#   - SUPABASE_URL
#   - SUPABASE_PUBLISHABLE_KEY
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_PUBLISHABLE_KEY
#
# Required for Production environment only:
#   - SUPABASE_SERVICE_ROLE_KEY (do NOT set in Development/Preview)
#   - CRON_SECRET
#   - OPENROUTER_API_KEY
#
# Vercel automatically passes all environment variables to:
#   - Server functions (via process.env)
#   - Client build-time (Vite; only VITE_-prefixed vars)
#   - Build scripts

# ---- CLOUDFLARE WORKERS DEPLOYMENT ----
# When deploying to Cloudflare Workers:
#
# 1. Set in wrangler.jsonc [env.production] section:
#   - SUPABASE_URL
#   - SUPABASE_PUBLISHABLE_KEY
#   - SUPABASE_SERVICE_ROLE_KEY
#   - CRON_SECRET
#   - OPENROUTER_API_KEY
#   - APP_URL
#
# 2. Or use Cloudflare Workers dashboard → Settings → Environment Variables
#
# 3. Run: wrangler deploy --env production

# ---- SETUP VERIFICATION ----
# After setting up this .env file, verify:
#   1. npm run predev      # Checks for missing/placeholder values
#   2. npm run dev         # Starts dev server with your credentials
#   3. Visit http://localhost:5173/login
#   4. Try email signup (creates real user in Supabase)
#   5. Try password reset (sends email from Supabase)
#   6. Google OAuth sign-up (if provider is enabled)
#   7. Try logout → login again (verifies session persistence)

# --- Next.js client-exposed vars (replace the former VITE_* build-time inlining) ---
NEXT_PUBLIC_SUPABASE_URL="https://slcmqbbjzyztqyucauol.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[your-publishable-key]"
# Optional. When set, it becomes the canonical origin in <link rel=canonical>,
# og:url and the sitemap. Leave unset in local development so the app falls back
# to window.location.origin in the browser and https://raval.ai on the server.
# NEXT_PUBLIC_APP_URL=https://raval.ai
# Optional logo.dev token used by the workspace logo lookup.
# NEXT_PUBLIC_LOVABLE_CONNECTOR_LOGO_DEV_API_KEY=
